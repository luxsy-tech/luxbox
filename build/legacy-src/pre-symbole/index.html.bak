<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Security-Policy"
        content="default-src 'self'; img-src 'self' data: crx: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'">
  <title>Luxbox</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <nav class="rail" data-i18n-attr="aria-label:nav.apps">
    <div id="apps" class="apps"></div>
    <browser-action-list id="actions" alignment="top right" hidden></browser-action-list>
    <button id="syncBtn" class="add small" data-i18n-attr="title:nav.sync;aria-label:nav.sync">☁</button>
    <button id="extBtn" class="add small" data-i18n-attr="title:nav.extensions;aria-label:nav.extensions">🧩</button>
    <button id="add" class="add" data-i18n-attr="title:nav.add;aria-label:nav.add">+</button>
  </nav>

  <main class="empty" id="empty" hidden>
    <h1 data-i18n="empty.title">Noch keine Apps</h1>
    <p data-i18n="empty.text">Füge mit „+“ deine erste App hinzu, zum Beispiel WhatsApp, Slack oder eine interne Webseite.</p>
  </main>

  <dialog id="dlg">
    <h2 id="dlgTitle" data-i18n="dlg.titleAdd">App hinzufügen</h2>
    <div class="field" id="presetField">
      <label for="preset" data-i18n="dlg.preset">Vorlage</label>
      <select id="preset"></select>
    </div>
    <div class="field">
      <label for="name" data-i18n="dlg.name">Name</label>
      <input id="name" autocomplete="off">
    </div>
    <div class="field">
      <label for="url" data-i18n="dlg.url">Adresse</label>
      <input id="url" data-i18n-attr="placeholder:dlg.urlPlaceholder" placeholder="https://…" autocomplete="off">
    </div>
    <label class="check">
      <input id="ignore" type="checkbox">
      <span data-i18n="dlg.ignoreCerts">Zertifikatswarnungen für diese App ignorieren</span>
    </label>
    <label class="check">
      <input id="own" type="checkbox">
      <span data-i18n="dlg.ownSession">Eigene Sitzung (getrennte Logins, z. B. für ein zweites Konto)</span>
    </label>
    <label class="check">
      <input id="keep" type="checkbox">
      <span data-i18n="dlg.keepAlive">Im Hintergrund aktiv halten (Benachrichtigungen, Anrufe)</span>
    </label>
    <p class="hint" data-i18n="dlg.hint">Ohne eigene Sitzung teilen sich Apps Logins und Erweiterungen. Apps, die nicht im Hintergrund aktiv bleiben, gehen nach einiger Zeit in den Ruhezustand und geben ihren Speicher frei.</p>
    <p id="error" class="error" role="alert"></p>
    <div class="actions">
      <button id="cancel" type="button" class="ghost" data-i18n="dlg.cancel">Abbrechen</button>
      <button id="save" type="button" class="primary" data-i18n="dlg.save">Speichern</button>
    </div>
  </dialog>

  <dialog id="extDlg">
    <h2 data-i18n="ext.title">Erweiterungen</h2>
    <div class="field">
      <label for="storeInput" data-i18n="ext.installFromStore">Aus dem Store installieren</label>
      <div class="row">
        <input id="storeInput" data-i18n-attr="placeholder:ext.storePlaceholder" placeholder="Store-Link oder Erweiterungs-ID" autocomplete="off">
        <select id="storeKind" data-i18n-attr="aria-label:ext.storeSelect" aria-label="Store für reine IDs">
          <option value="chrome">Chrome</option>
          <option value="edge">Edge</option>
        </select>
        <button id="storeInstall" type="button" class="primary" data-i18n="ext.install">Installieren</button>
      </div>
    </div>
    <div class="store-links">
      <button id="openChrome" type="button" class="ghost" data-i18n="ext.openChrome">Chrome Web Store öffnen</button>
      <button id="openEdge" type="button" class="ghost" data-i18n="ext.openEdge">Edge Add-ons öffnen</button>
    </div>
    <p class="hint" data-i18n-html="ext.hint">Im geöffneten Store die Seite der Erweiterung aufrufen und im Menü <strong>Erweiterungen → Aktuelle Store-Seite installieren</strong> wählen. Alternativ den Link der Seite hier einfügen.</p>
    <ul id="extList" class="ext-list"></ul>
    <p id="extError" class="error" role="alert"></p>
    <div class="actions">
      <button id="extFolder" type="button" class="ghost" data-i18n="ext.folder">Entpackten Ordner laden …</button>
      <button id="extClose" type="button" class="primary" data-i18n="ext.close">Schließen</button>
    </div>
  </dialog>

  <dialog id="syncDlg">
    <h2 data-i18n="sync.title">config-Sync</h2>
    <p class="hint" data-i18n="sync.hint1">Wähle einen Ordner innerhalb deines sync-Verzeichnisses. Luxbox legt dort pro Gerät eine Datei ab und gleicht sie mit den anderen Geräten ab. Der Sync Client selbst überträgt die Datei, Luxbox braucht keine Zugangsdaten.</p>
    <p class="hint" data-i18n-html="sync.hint2"><strong>Wird abgeglichen:</strong> Apps (Name, Adresse, Optionen, Reihenfolge), Einstellungen und die Liste der Store-Erweiterungen.<br><strong>Nie abgeglichen:</strong> Passwörter, Logins und Cookies, Erweiterungsdaten, Favicons. Auf jedem Gerät meldest du dich einmal selbst an.</p>
    <div id="syncStatus" class="sync-status"></div>
    <p id="syncError" class="error" role="alert"></p>
    <div class="actions">
      <button id="syncOff" type="button" class="ghost" data-i18n="sync.stop">Sync beenden</button>
      <button id="syncNow" type="button" class="ghost" data-i18n="sync.now">Jetzt abgleichen</button>
      <button id="syncChoose" type="button" class="ghost" data-i18n="sync.choose">Ordner wählen …</button>
      <button id="syncClose" type="button" class="primary" data-i18n="sync.close">Schließen</button>
    </div>
  </dialog>

  <script src="renderer.js"></script>
</body>
</html>
