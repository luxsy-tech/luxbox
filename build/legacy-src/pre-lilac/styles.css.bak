:root {
  --bg: #14161b;
  --rail: #1b1e25;
  --tile: #262a33;
  --tile-hover: #313642;
  --text: #e8eaef;
  --muted: #8d94a3;
  --accent: #824eb3;
  --badge: #f2a541;
  --danger: #ff7b72;
  font-family: "Segoe UI", system-ui, sans-serif;
}

* { box-sizing: border-box; }

html, body { height: 100%; margin: 0; background: var(--bg); color: var(--text); }
body { display: flex; }

.rail {
  width: 72px;
  height: 100vh;
  padding: 12px 0;
  background: var(--rail);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.apps {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  overflow-y: auto;
  scrollbar-width: none;
}

.app {
  position: relative;
  width: 46px;
  height: 46px;
  flex: none;
  border: 0;
  border-radius: 14px;
  background: var(--tile);
  color: var(--text);
  font-family: inherit; font-weight: 600; font-size: 18px;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: background 0.15s, border-radius 0.15s;
}
.app:hover { background: var(--tile-hover); border-radius: 12px; }
.app.dragging { opacity: 0.4; }
.app.active { background: var(--tile-hover); border-radius: 12px; }
.app.active::before {
  content: "";
  position: absolute;
  left: -13px;
  top: 10px;
  bottom: 10px;
  width: 4px;
  border-radius: 0 4px 4px 0;
  background: var(--accent);
}
.app img { width: 26px; height: 26px; border-radius: 6px; object-fit: contain; }
.app.loading { animation: pulse 1.2s ease-in-out infinite; }
.app.muted::after {
  content: "🔇";
  position: absolute;
  left: -2px;
  bottom: -4px;
  font-size: 12px;
}

.badge {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: var(--badge);
  color: #1b1405;
  font: 700 11px/18px "Segoe UI", sans-serif;
  text-align: center;
}

.add {
  width: 46px;
  height: 46px;
  border: 1.5px dashed #444b5a;
  border-radius: 14px;
  background: transparent;
  color: var(--muted);
  font-size: 24px;
  cursor: pointer;
}
.add:hover { color: var(--text); border-color: var(--muted); }

.empty { flex: 1; display: grid; place-content: center; text-align: center; padding: 40px; }
.empty[hidden] { display: none; }
.empty h1 { margin: 0 0 8px; font-size: 22px; font-weight: 600; }
.empty p { margin: 0; max-width: 42ch; color: var(--muted); line-height: 1.5; }

dialog {
  width: 420px;
  padding: 24px;
  border: 1px solid #343a47;
  border-radius: 14px;
  background: var(--rail);
  color: var(--text);
}
dialog::backdrop { background: rgba(0, 0, 0, 0.55); }
dialog h2 { margin: 0 0 16px; font-size: 18px; font-weight: 600; }

.field { margin-bottom: 14px; }
.field label { display: block; margin-bottom: 6px; font-size: 13px; color: var(--muted); }
input[type="text"], input:not([type]), select {
  width: 100%;
  padding: 9px 10px;
  border: 1px solid #3a4150;
  border-radius: 8px;
  background: var(--bg);
  color: var(--text);
  font: inherit;
}
input:focus-visible, select:focus-visible, button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
.check { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); }
.error { min-height: 18px; margin: 10px 0 0; font-size: 13px; color: var(--danger); }
.actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px; }
.actions button { padding: 9px 16px; border: 0; border-radius: 8px; font-family: inherit; font-weight: 600; font-size: 14px; cursor: pointer; }
.primary { background: var(--accent); color: #0d2522; }
.ghost { background: var(--tile); color: var(--text); }

@keyframes pulse { 50% { opacity: 0.6; } }
@media (prefers-reduced-motion: reduce) {
  .app { transition: none; }
  .app.loading { animation: none; }
}

.add.small { width: 36px; height: 36px; border-radius: 10px; font-size: 16px; }
.hint { margin: 0 0 12px; font-size: 13px; line-height: 1.45; color: var(--muted); }
.hint code { color: var(--text); }
.ext-list { list-style: none; margin: 0; padding: 0; max-height: 240px; overflow-y: auto; }
.ext-list li { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #2c313c; }
.ext-list .meta { flex: 1; min-width: 0; }
.ext-list .meta strong { display: block; font-weight: 600; }
.ext-list .meta span { display: block; font-size: 12px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ext-list button { border: 0; border-radius: 6px; padding: 6px 10px; background: var(--tile); color: var(--text); cursor: pointer; font-family: inherit; }
.ext-list .none { color: var(--muted); border: 0; }

browser-action-list { display: flex; flex-direction: column; align-items: center; gap: 6px; }
browser-action-list[hidden] { display: none; }
browser-action-list::part(action) { width: 34px; height: 34px; border-radius: 10px; }
.row { display: flex; gap: 8px; }
.row input { flex: 1; min-width: 0; }
.row select { width: auto; }
.row button { border: 0; border-radius: 8px; padding: 0 14px; font-family: inherit; font-weight: 600; cursor: pointer; }
.store-links { display: flex; gap: 8px; margin-bottom: 10px; }
.store-links button { border: 0; border-radius: 8px; padding: 8px 12px; font-family: inherit; cursor: pointer; }
.ext-list li .meta span.src { color: var(--accent); }
dialog#extDlg { width: 520px; }

.app.hibernated { opacity: 0.55; }
.app.hibernated img { filter: grayscale(1); }

dialog#syncDlg { width: 520px; }
.sync-status { font-size: 13px; line-height: 1.6; color: var(--text); }
.sync-status .muted { color: var(--muted); }
.sync-status ul { margin: 4px 0 0; padding-left: 18px; }

.ext-list .meta span.status { color: var(--accent); }
.ext-list .meta span.status.bad { color: var(--danger); white-space: normal; }
